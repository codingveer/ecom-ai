{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neutail-services",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The ONLY Worker in this deployment with a database binding.
  "d1_databases": [
    { "binding": "DB", "database_name": "NEUTAIL", "database_id": "675e2809-af1d-418a-8db6-6f02b64bb029" }
  ],

  // Embeddings + vector index for opt-in semantic search (catalogue.search?searchMode=semantic).
  // Neither has a local simulator - both always call the real Cloudflare API, same reason
  // packages/llm/wrangler.jsonc's AI binding comment gives. `ai` is unconditionally remote in
  // wrangler's binding classification, but `vectorize` needs `remote: true` explicitly, or
  // `wrangler dev` in normal mixed mode (D1 local, everything else proxied) throws "Binding
  // VECTORS needs to be run remotely" at call time instead of actually proxying it - found
  // during Task 3, `remote: true` added here rather than left implicit.
  "ai": { "binding": "AI" },
  "vectorize": [
    { "binding": "VECTORS", "index_name": "neutail-catalogue", "remote": true }
  ],

  // Not publicly routable once deployed - reached only through service bindings.
  "workers_dev": false
}
