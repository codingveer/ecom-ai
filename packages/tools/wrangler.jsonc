{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neutail-tools",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // No d1_databases entry. This Worker cannot reach the data store; it can only
  // call the services Worker through the contract declared in the registry.
  "kv_namespaces": [
    { "binding": "REGISTRY", "id": "2b8717adec81428a9f103370da6097fe" }
  ],
  "services": [
    { "binding": "SERVICES", "service": "neutail-services" }
  ],
  "analytics_engine_datasets": [
    { "binding": "AUDIT", "dataset": "neutail_tool_audit" }
  ],
  "workers_dev": false
}
