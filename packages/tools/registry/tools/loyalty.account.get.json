{
  "name": "loyalty.account.get",
  "version": "1.0.0",
  "purpose": "Read points balance, tier and engagement score.",
  "allowed_agents": [
    "loyalty",
    "upsell",
    "orchestrator"
  ],
  "input_schema": {
    "customer_id": {
      "type": "string",
      "required": true
    }
  },
  "output_schema": {
    "tier": "string",
    "points_balance": "integer",
    "points_to_next_tier": "integer",
    "fit_streak": "integer",
    "fit_streak_multiplier": "number",
    "badges": "array",
    "quests": "array"
  },
  "transport": {
    "service": "services",
    "method": "GET",
    "path": "/loyalty/{customer_id}"
  }
}
